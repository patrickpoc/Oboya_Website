# Supabase (required in production on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — server-only (seed scripts + Users & Permissions APIs). Never expose in the browser / never use NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required in production for form writes, RFQ, and CMS admin APIs.
# Hosted deploys without this key fail closed (503) instead of writing as anon.

# First CMS profile matching this email is promoted to super_admin (bootstrap only).
# CMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# After admin MFA is enrolled in Supabase Auth:
# CMS_REQUIRE_MFA=true

# Vercel Cron authorization for GET /api/cron/purge-forms
CRON_SECRET=generate-a-long-random-secret

# Optional Cloudflare Turnstile (public forms)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# create-admin-user.mjs — never commit a real password
# ADMIN_PASSWORD=
